{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipboardHistory",
  "version": "0.1.0",
  "identifier": "com.aentrance.clipboardhistory",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "剪贴板历史",
        "width": 460,
        "height": 680,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
